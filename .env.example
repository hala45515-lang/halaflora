# Unsplash API: get your Access Key from https://unsplash.com/developers
# Server-side only. Never prefix with NEXT_PUBLIC_.
UNSPLASH_ACCESS_KEY=

# Public origin of the deployed site (no trailing slash), e.g. https://halaflora.com
# Used for canonical URLs, Open Graph, sitemap and robots.
# Optional: falls back to Vercel's production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
